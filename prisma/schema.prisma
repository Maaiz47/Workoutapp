generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  username          String           @unique
  email             String?          @unique
  passwordHash      String?
  mustResetPassword Boolean          @default(false)
  role              String           @default("user")
  roleRequest       String?          // pending role upgrade request, e.g. "trainer"
  roleRequestNote   String?          // optional note submitted by the user
  roleRequestAt     DateTime?
  createdAt         DateTime         @default(now())
  workoutLogs       WorkoutLog[]
  profile           UserProfile?
  workoutPlan       WorkoutPlan?
  sentRequests      TrainerRequest[] @relation("SentRequests")
  receivedRequests  TrainerRequest[] @relation("ReceivedRequests")
  trainerClients    TrainerClient[]  @relation("TrainerClients")
  clientOf          TrainerClient?   @relation("ClientOf")
  sentMessages      Message[]        @relation("SentMessages")
  receivedMessages  Message[]        @relation("ReceivedMessages")
  pushSubscriptions PushSubscription[]
  trainerProposals  PlanProposal[]   @relation("TrainerProposals")
  clientProposals   PlanProposal[]   @relation("ClientProposals")
  bodyMetrics       BodyMetric[]
  savedRoutines     SavedRoutine[]
}

model TrainerRequest {
  id        String   @id @default(cuid())
  trainerId String
  userId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trainer   User     @relation("SentRequests",     fields: [trainerId], references: [id], onDelete: Cascade)
  user      User     @relation("ReceivedRequests", fields: [userId],    references: [id], onDelete: Cascade)

  @@unique([trainerId, userId])
  @@index([userId])
  @@index([trainerId])
}

model TrainerClient {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String   @unique
  createdAt DateTime @default(now())
  trainer   User     @relation("TrainerClients", fields: [trainerId], references: [id], onDelete: Cascade)
  client    User     @relation("ClientOf",       fields: [clientId],  references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  dob              DateTime
  gender           String
  heightCm         Float
  weightKg         Float
  bodyFatPct       Float?
  goal             String   @default("muscle")
  goals            String[]
  fitnessLevel     String
  location         String
  equipment        String[]
  daysPerWeek      Int
  targetArea       String?  @default("none")
  targetAreas      String[]
  targetWeightKg   Float?
  targetBodyFatPct Float?
  hiitPreference   String?
  hiitIntensity    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutPlan {
  id        String    @id @default(cuid())
  userId    String    @unique
  days      PlanDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanDay {
  id          String        @id @default(cuid())
  planId      String
  dayIndex    Int
  title       String
  subtitle    String
  focus       String
  exercises   PlanExercise[]
  plan        WorkoutPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model PlanExercise {
  id         String  @id @default(cuid())
  dayId      String
  order      Int
  exerciseId String
  name       String
  sets       Int
  reps       String
  rest       Int
  notes      String?
  groupId    String?
  groupType  String?
  dropSets   Int     @default(0)
  day        PlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id         String        @id @default(cuid())
  fromId     String
  toId       String
  body       String
  type       String        @default("text")
  requestId  String?
  proposalId String?
  read       Boolean       @default(false)
  createdAt  DateTime      @default(now())
  from       User          @relation("SentMessages",     fields: [fromId], references: [id], onDelete: Cascade)
  to         User          @relation("ReceivedMessages", fields: [toId],   references: [id], onDelete: Cascade)
  proposal   PlanProposal? @relation(fields: [proposalId], references: [id])

  @@index([toId])
  @@index([fromId, toId])
}

model PlanProposal {
  id        String    @id @default(cuid())
  trainerId String
  clientId  String
  status    String    @default("pending")
  planJson  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  trainer   User      @relation("TrainerProposals", fields: [trainerId], references: [id], onDelete: Cascade)
  client    User      @relation("ClientProposals",  fields: [clientId],  references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([clientId])
  @@index([trainerId])
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @default(now())
  weightKg   Float?
  bodyFatPct Float?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkoutLog {
  id       String   @id @default(cuid())
  userId   String
  dayId    String
  date     DateTime @default(now())
  duration String
  sets     Json
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayId])
  @@index([userId])
}

model SavedRoutine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  planJson  Json
  sharedBy  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
