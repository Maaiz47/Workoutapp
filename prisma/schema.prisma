generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  username          String           @unique
  email             String?          @unique
  passwordHash      String?
  mustResetPassword Boolean          @default(false)
  role              String           @default("user")
  // Synthetic test users seeded by the admin's "Test User Generator"
  // (Settings → DEV TOOLS). Filtered out of public leaderboards unless
  // the AppConfig.showTestUsersInLeaderboards toggle is on. Bulk-
  // wipeable via the admin tools. NEVER set this on a real user.
  // (qa: test-user-generator)
  isTestUser        Boolean          @default(false)
  // The archetype this test user was seeded as (e.g. "completionist",
  // "veteran", "trainer"). Null on real users. Used by the daily-tick
  // engine to decide what activity to generate.
  testArchetype     String?
  // Extra roles a user holds *in addition to* their primary `role`. Lets a
  // single account act as both admin AND trainer (or any combination)
  // without forcing a single-role choice. Checked via userHasRole().
  extraRoles        String[]         @default([])
  roleRequest       String?          // pending role upgrade request, e.g. "trainer"
  roleRequestNote   String?          // optional note submitted by the user
  roleRequestAt     DateTime?
  createdAt         DateTime         @default(now())
  workoutLogs       WorkoutLog[]
  profile           UserProfile?
  workoutPlan       WorkoutPlan?
  sentRequests      TrainerRequest[] @relation("SentRequests")
  receivedRequests  TrainerRequest[] @relation("ReceivedRequests")
  trainerClients    TrainerClient[]  @relation("TrainerClients")
  clientOf          TrainerClient?   @relation("ClientOf")
  sentMessages      Message[]           @relation("SentMessages")
  receivedMessages  Message[]           @relation("ReceivedMessages")
  sentGroupMessages GroupMessage[]      @relation("SentGroupMessages")
  pushSubscriptions PushSubscription[]
  messageReactions  MessageReaction[]
  trainerProposals  PlanProposal[]   @relation("TrainerProposals")
  clientProposals   PlanProposal[]   @relation("ClientProposals")
  bodyMetrics       BodyMetric[]
  savedRoutines     SavedRoutine[]
  lastSeenAt        DateTime?
  customExercises   CustomExercise[]
  createdGroups     LeaderboardGroup[]       @relation("CreatedGroups")
  groupMemberships  LeaderboardGroupMember[] @relation("GroupMemberships")
  sentGroupInvites  LeaderboardGroupInvite[] @relation("SentGroupInvites")
  receivedGroupInvites LeaderboardGroupInvite[] @relation("ReceivedGroupInvites")
  friendshipsA      Friendship[]             @relation("FriendshipUserA")
  friendshipsB      Friendship[]             @relation("FriendshipUserB")
}

// Athlete-to-athlete (or any-user-to-any-user) social connection.
// userA is always the row's "requester" — the user who initiated the
// request. userB is the recipient. Once status flips to "accepted" the
// relationship is bidirectional at the read layer (both users are
// equally "friends"), but the requester direction is preserved for
// audit. Block is one-directional: whichever side called PATCH with
// action=block becomes userA on the resulting row.
// (qa: friend-system-athletes)
model Friendship {
  id          String    @id @default(cuid())
  userAId     String
  userBId     String
  status      String    @default("pending") // "pending" | "accepted" | "blocked"
  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  userA       User      @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User      @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
}

model TrainerRequest {
  id        String   @id @default(cuid())
  trainerId String
  userId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trainer   User     @relation("SentRequests",     fields: [trainerId], references: [id], onDelete: Cascade)
  user      User     @relation("ReceivedRequests", fields: [userId],    references: [id], onDelete: Cascade)

  @@unique([trainerId, userId])
  @@index([userId])
  @@index([trainerId])
}

model TrainerClient {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String   @unique
  createdAt DateTime @default(now())
  trainer   User     @relation("TrainerClients", fields: [trainerId], references: [id], onDelete: Cascade)
  client    User     @relation("ClientOf",       fields: [clientId],  references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  dob              DateTime
  gender           String
  heightCm         Float
  weightKg         Float
  bodyFatPct       Float?
  goal             String   @default("muscle")
  goals            String[]
  fitnessLevel     String
  location         String
  equipment        String[]
  equipmentHome    String[]   // populated only when location="both"
  equipmentGym     String[]   // populated only when location="both"
  daysPerWeek      Int
  targetArea       String?  @default("none")
  targetAreas      String[]
  targetWeightKg   Float?
  // Training modalities the user is interested in. Multi-select.
  // Default treated as ["strength"] at read time when empty so existing
  // users keep their classic experience. Recognised values:
  //   "strength"     — classic weighted lifting (default)
  //   "calisthenics" — bias plan toward bodyweight progressions
  //   "recovery"     — include a Mobility/Recovery day in the plan
  //   "cardio"       — keep cardio finishers / dedicated cardio day on
  modalities       String[]   @default([])
  targetBodyFatPct Float?
  hiitPreference   String?
  hiitIntensity    String?
  // Target session duration in minutes. Used by planGenerator to
  // pick supersets / drop sets / HIIT finishers for tighter
  // windows, and allow more isolation work for longer windows.
  // 45 = "Standard" baseline. (qa: onboarding-profile-setup)
  targetSessionMinutes Int?
  // Dedicated cardio day preference. Recognised values:
  //   null / "none" — no dedicated cardio day (default)
  //   "steady"      — one steady-state LISS day (30–40 min easy pace)
  //   "intervals"   — one interval day (10×1min hard / 1min easy)
  //   "mixed"       — alternates steady + intervals each week
  // The day is appended in addition to the strength split, so a user
  // with 4 strength days + cardioPreference becomes a 5-day plan.
  // (qa: plan-cardio-day)
  cardioPreference String?
  // Tier theme — affects ONLY the visual name/icon of the athlete
  // ladder. The numeric tier (1-6) is universal across themes so
  // leaderboards, milestones, and the underlying score remain
  // theme-agnostic. Recognised values:
  //   null / "vivid" — animal names (Kitten → Bear). Default.
  //   "simple"       — Bronze → Silver → Gold → Platinum →
  //                    Diamond → Master.
  // Trainer ladder ignores this — same labels everywhere.
  // (qa: tier-themes)
  tierTheme        String?
  // Opt-OUT of the global athlete leaderboard. When true, the user's
  // row on the global board shows as "Athlete #<rank>" instead of
  // @username. Trainers don't get this toggle — the trainer
  // leaderboard is intentionally public-facing (clients use it to
  // pick coaches). (qa: tier-global-leaderboard)
  hideFromGlobalLeaderboard Boolean @default(false)
  // Selected profile avatar id (matches an id in lib/avatars.ts). Null
  // = use the default initial-letter chip. Avatars are unlocked either
  // via tier progression (deterministic) or via the random "lucky
  // drop" pool (probabilistic — see lib/avatars.ts).
  // (qa: profile-avatars)
  avatarId         String?
  // Cumulative "lucky" tier-score bonus earned from random rare rewards.
  // Added to the headline athlete score so the lottery-style drops feel
  // real on the same metric the user cares about (no parallel XP/coin
  // currency). Persists, never goes down. Capped at +20 lifetime so it
  // can't dominate the score. (qa: random-rare-rewards)
  tierScoreBonus   Int      @default(0)
  // ISO timestamp (ms) of the last lucky drop. Used to enforce a 24h
  // cooldown so users can't farm sessions for drops. Null = never.
  lastLuckyDropAt  DateTime?
  // Cooldown for the suggested-workout bonus — +1 to tierScoreBonus
  // when the user logs a session on the algorithmically-suggested
  // "NEXT UP" day. Same +20 lifetime cap as the lucky drops (shared
  // bucket). 20h cooldown so a daily lifter can earn one per day at
  // most. (qa: suggestion-bonus)
  lastSuggestionBonusAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-row-per-unlock record of an avatar a user has earned. `source`
// is "tier" for deterministic tier-threshold unlocks and "lucky" for
// random rare-pool drops. `tier` is set only for tier-source rows so
// we know which rung minted it.
// (qa: profile-avatars, random-rare-rewards)
model UserAvatarUnlock {
  id         String   @id @default(cuid())
  userId     String
  avatarId   String
  source     String   // "tier" | "lucky"
  tier       Int?     // 1-6 when source="tier"
  unlockedAt DateTime @default(now())

  @@unique([userId, avatarId])
  @@index([userId])
}

model WorkoutPlan {
  id        String    @id @default(cuid())
  userId    String    @unique
  days      PlanDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanDay {
  id          String        @id @default(cuid())
  planId      String
  dayIndex    Int
  title       String
  subtitle    String
  focus       String
  exercises   PlanExercise[]
  plan        WorkoutPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model PlanExercise {
  id         String  @id @default(cuid())
  dayId      String
  order      Int
  exerciseId String
  name       String
  sets       Int
  reps       String
  rest       Int
  notes      String?
  groupId    String?
  groupType  String?
  dropSets   Int     @default(0)
  dropSet    Boolean @default(false)
  kind       String  @default("main") // "warmup" | "main" | "cooldown"
  day        PlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id         String            @id @default(cuid())
  fromId     String
  toId       String
  body       String
  type       String            @default("text")
  requestId  String?
  proposalId String?
  replyToId  String?
  delivered  Boolean           @default(false)
  read       Boolean           @default(false)
  createdAt  DateTime          @default(now())
  from       User              @relation("SentMessages",     fields: [fromId], references: [id], onDelete: Cascade)
  to         User              @relation("ReceivedMessages", fields: [toId],   references: [id], onDelete: Cascade)
  proposal   PlanProposal?     @relation(fields: [proposalId], references: [id])
  replyTo    Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[]         @relation("MessageReplies")
  reactions  MessageReaction[]

  @@index([toId])
  @@index([fromId, toId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Group chat — separate from the 1:1 Message model so the DM schema
// stays untouched. Every member of a LeaderboardGroup can send
// messages here. `fromId` is nullable to support SYSTEM messages
// (mission-started, member PB, achievement unlocked) where there's
// no human author. Type field distinguishes plain text from system
// events so the client can render them differently.
// (qa: group-chat-system-messages)
model GroupMessage {
  id        String           @id @default(cuid())
  groupId   String
  fromId    String?          // null = system message
  body      String
  // 'text' = user-sent. 'system_mission' = group challenge created.
  // 'system_pb' = member hit a notable PB. 'system_achievement' = member
  // unlocked an achievement. Add more types as system hooks come in.
  type      String           @default("text")
  createdAt DateTime         @default(now())
  group     LeaderboardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      User?            @relation("SentGroupMessages", fields: [fromId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

model PlanProposal {
  id        String    @id @default(cuid())
  trainerId String
  clientId  String
  status    String    @default("pending")
  planJson  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  trainer   User      @relation("TrainerProposals", fields: [trainerId], references: [id], onDelete: Cascade)
  client    User      @relation("ClientProposals",  fields: [clientId],  references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([clientId])
  @@index([trainerId])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  url       String                          // Vercel Blob URL
  takenAt   DateTime @default(now())
  weightKg  Float?                          // snapshot of bodyweight at the time
  notes     String?                         // user caption, optional

  @@index([userId, takenAt])
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @default(now())
  weightKg   Float?
  bodyFatPct Float?
  // When the user logged the metric: "morning" or "evening".
  // Lets the trend chart colour-code points and reminds the user
  // that morning-fasted readings are more reliable. Nullable for
  // backwards compat with historical entries. (qa: body-metric-timeofday)
  timeOfDay  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkoutLog {
  id               String        @id @default(cuid())
  userId           String
  dayId            String
  date             DateTime      @default(now())
  duration         String
  sets             Json
  intensityPoints  Int           @default(0)
  // Optional tag — set when the session was started from a day that
  // belongs to a group's shared workout. Drives the filtered group
  // leaderboard so only "actually doing the prescribed work" counts.
  groupWorkoutId   String?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupWorkout     GroupWorkout? @relation(fields: [groupWorkoutId], references: [id], onDelete: SetNull)

  @@index([userId, dayId])
  @@index([userId])
  @@index([groupWorkoutId])
}

model SavedRoutine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  planJson  Json
  sharedBy  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomExercise {
  id               String   @id @default(cuid())
  trainerId        String
  name             String
  primaryMuscles   String[]
  secondaryMuscles String[]
  equipment        String[]
  type             String   @default("compound")
  difficulty       String   @default("intermediate")
  photoUrls        String[]
  createdAt        DateTime @default(now())
  trainer          User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model LeaderboardGroup {
  id             String                   @id @default(cuid())
  name           String
  createdBy      String
  privacy        String                   @default("private") // "private" | "public"
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  creator        User                     @relation("CreatedGroups", fields: [createdBy], references: [id], onDelete: Cascade)
  members        LeaderboardGroupMember[]
  invites        LeaderboardGroupInvite[]
  workout        GroupWorkout?
  challenges     GroupChallenge[]
  messages       GroupMessage[]

  @@index([createdBy])
}

// One optional shared workout per leaderboard group. Stored as a JSON
// blob of days for simplicity — no nested PlanDay/PlanExercise tables.
// When set, every member is auto-subscribed (activated=false). Members
// must `apply` it before its days show up in their plan and their
// sessions count for the group's filtered leaderboard.
model GroupWorkout {
  id            String                       @id @default(cuid())
  groupId       String                       @unique
  name          String
  description   String?
  // Serialised days array — same shape as the existing WorkoutDay /
  // PlanDay output the home view consumes:
  //   [{ id, title, focus, color, gradient, exercises: [{id,name,sets,reps,rest,...}] }]
  days          Json
  createdBy     String                       // userId of the trainer who set it
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  group         LeaderboardGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subscriptions GroupWorkoutSubscription[]
  workoutLogs   WorkoutLog[]
}

// Per-group challenge — opt-in by group leader, runs for a window,
// every member contributes to a single shared progress bar. Metric
// types mirror lib/challenges.ts so the catalogue stays one source
// of truth. Progress is recomputed on read from member WorkoutLogs
// (no cached counter — keeps the data correct after edits/deletes).
// (qa: group-challenges)
model GroupChallenge {
  id         String           @id @default(cuid())
  groupId    String
  createdBy  String           // userId of the group leader who started it
  // "total_reps" | "total_sessions" | "total_volume_kg" | "exercise_distinct"
  metric     String
  target     Int
  title      String
  // Optional comma-separated exercise-substring filter for reps/volume metrics.
  // Lets a group run e.g. "1000 push-ups together this month".
  exerciseSubstrings String?
  startedAt  DateTime         @default(now())
  endsAt     DateTime
  // "active" | "completed" | "expired" — auto-derived at read time
  // but persisted so historical state is preserved.
  state      String           @default("active")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  group      LeaderboardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, state])
}

// Per-user subscription to a GroupWorkout. Auto-created at workout-set
// time for every existing member; also created when new members join a
// group that has a workout. `activated=true` only when the user taps
// APPLY in their own app — gates the group days showing up in home and
// gates the user appearing in the group's filtered leaderboard.
model GroupWorkoutSubscription {
  id              String       @id @default(cuid())
  userId          String
  groupWorkoutId  String
  activated       Boolean      @default(false)
  joinedAt        DateTime     @default(now())
  activatedAt     DateTime?
  groupWorkout    GroupWorkout @relation(fields: [groupWorkoutId], references: [id], onDelete: Cascade)

  @@unique([userId, groupWorkoutId])
  @@index([userId])
  @@index([groupWorkoutId])
}

model LeaderboardGroupMember {
  id              String           @id @default(cuid())
  groupId         String
  userId          String
  role            String           @default("client") // "trainer" | "client"
  trainerId       String?          // which trainer added this client (null for trainers themselves)
  includeInRank   Boolean          @default(true)
  joinedAt        DateTime         @default(now())
  group           LeaderboardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User             @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model LeaderboardGroupInvite {
  id          String           @id @default(cuid())
  groupId     String
  inviterId   String
  inviteeId   String
  status      String           @default("pending") // "pending" | "accepted" | "declined"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  group       LeaderboardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter     User             @relation("SentGroupInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User             @relation("ReceivedGroupInvites", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([groupId])
  @@index([inviteeId])
}

model QAReport {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  tester      String
  payloadJson String
}

// Tiny key-value store for app-wide settings the admin can flip from
// the UI without a redeploy. Currently used by the test-user generator
// (showTestUsersInLeaderboards). Add new keys as needed — keep values
// JSON-encoded strings so the column type stays simple. Single row per
// key (key is the primary key). (qa: test-user-generator)
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Per-item testing comment. Replaces the whole-form QAReport model.
// Items get a thread of these over time; the latest comment's status
// is treated as the item's current status by the QA processing pass.
model QAComment {
  id            String    @id @default(cuid())
  itemId        String
  // 0-indexed step within the item's steps[] array that this comment
  // is about. Null = comment is about the item as a whole (legacy
  // behaviour). Lets a tester flag a SPECIFIC step instead of just
  // the whole flow. (qa: qa-per-step-comments)
  stepIndex     Int?
  tester        String
  userId        String?   // set when the comment came from a logged-in user (via Settings)
  status        String    // untested | passing | failing | regression-retest
  note          String
  screenshotUrl String?
  ts            DateTime  @default(now())
  processed     Boolean   @default(false)
  processedAt   DateTime?
  processedSha  String?

  @@index([itemId])
  @@index([itemId, stepIndex])
  @@index([processed, ts])
  @@index([userId])
}
